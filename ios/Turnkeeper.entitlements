<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The iPad app's entitlements: the Tableside Toolkit's App Group, where Scrollkeeper keeps its downloads and library
     list, which Import from Scrollkeeper reads (scrollkeeper#52); and the toolkit's iCloud container, through which
     the library syncs between the user's devices, with push notifications, which CKSyncEngine uses to hear of
     changes. Xcode signs debug builds for CloudKit's Development environment and App Store builds for Production. -->
<plist version="1.0">
<dict>
    <key>aps-environment</key>
    <string>development</string>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.io.github.scooper4711.tableside</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.io.github.scooper4711.tableside</string>
    </array>
</dict>
</plist>
