<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The iCloud container the library syncs through; the app syncs only when this names one (tabletop-kit
         library sync R6.1). Signing.xcconfig sets it, and the simulator scripts empty it: their builds have no iCloud
         entitlement, and CloudKit stops an app that opens a container without one. -->
    <key>TablesideSyncContainer</key>
    <string>$(TABLESIDE_SYNC_CONTAINER)</string>
    <key>TablesideSyncEnvironment</key>
    <string>$(TABLESIDE_SYNC_ENVIRONMENT)</string>
    <!-- CKSyncEngine's silent pushes, so another device's changes arrive while the app is in the background. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
    <key>NSBonjourServices</key>
    <array>
        <string>_turnkeeper-table._tcp</string>
    </array>
    <key>UIAppFonts</key>
    <array/>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Turnkeeper Library</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>io.github.scooper4711.turnkeeper.library</string>
            </array>
        </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>io.github.scooper4711.turnkeeper.library</string>
            <key>UTTypeDescription</key>
            <string>Turnkeeper Library</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>turnkeeper</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>io.github.scooper4711.pluck.statblock</string>
            <key>UTTypeDescription</key>
            <string>Pathfinder Stat Block</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
            </array>
        </dict>
        <!-- Pawn Shop's sheet, which Turnkeeper shares (R3.9.6). The same as Pawn Shop declares it. -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>io.github.scooper4711.pawnsheet</string>
            <key>UTTypeDescription</key>
            <string>Pawn Sheet</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>pawnsheet</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
