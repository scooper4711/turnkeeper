// Signing and version settings for the iPad app.
//
// Put your own Apple developer team in Local.xcconfig next to this file. That file is not
// committed, so nobody's team ends up in the repository:
//
//     DEVELOPMENT_TEAM = ABCDE12345
//
// If Xcode reports that the bundle identifier is taken, set your own there as well:
//
//     PRODUCT_BUNDLE_IDENTIFIER = com.example.Turnkeeper
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = io.github.scooper4711.Turnkeeper

// The iCloud container the library syncs through, which Info.plist names (TablesideSyncContainer). It belongs to
// the publishing team: with another team, empty it in Local.xcconfig and remove the iCloud entitlements, and the app
// keeps its library on the device alone.
TABLESIDE_SYNC_CONTAINER = iCloud.io.github.scooper4711.tableside

// The CloudKit environment, which Info.plist names (TablesideSyncEnvironment). Builds installed from Xcode use
// Development and archives use Production. The shared library must know which, as its sync state fits only one.
TABLESIDE_SYNC_ENVIRONMENT = Production
TABLESIDE_SYNC_ENVIRONMENT[config=Debug] = Development

// The version and build number come from git (scripts/version.sh): the Turnkeeper-iPad scheme's build
// pre-action writes them to Version.xcconfig before every build, Product > Archive included. These are the
// fallbacks for a build that skips the scheme.
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 1
#include? "Version.xcconfig"

#include? "Local.xcconfig"
